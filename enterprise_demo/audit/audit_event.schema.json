{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.example/bap/audit-event.schema.json",
  "title": "BAP audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at_utc", "received_at_utc", "source", "kind", "message", "level", "outcome"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^evt-"},
    "occurred_at_utc": {"type": "string", "format": "date-time"},
    "received_at_utc": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "maxLength": 80},
    "kind": {"type": "string", "maxLength": 80},
    "message": {"type": "string", "maxLength": 1000},
    "level": {"enum": ["info", "success", "warning", "error"]},
    "outcome": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "decision_id": {"type": ["string", "null"]},
    "execution_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "agent_run_id": {"type": ["string", "null"]},
    "user_id": {"type": ["string", "null"]},
    "device_id": {"type": ["string", "null"]},
    "agent_type": {"type": ["string", "null"]},
    "agent_version": {"type": ["string", "null"]},
    "tool_name": {"type": ["string", "null"]},
    "task_summary": {"type": ["string", "null"], "maxLength": 4000},
    "action": {"type": ["string", "null"]},
    "resource": {"type": ["string", "null"]},
    "resource_key": {"type": ["string", "null"]},
    "decision": {"enum": ["ALLOW", "REQUIRE_APPROVAL", "DENY", null]},
    "decision_reason": {"type": ["string", "null"]},
    "policy_bundle_id": {"type": ["string", "null"]},
    "policy_revision": {"type": ["string", "null"]},
    "policy_rule_id": {"type": ["string", "null"]},
    "policy_bundle_sha256": {"type": ["string", "null"]},
    "approval_request_id": {"type": ["string", "null"]},
    "approver_id": {"type": ["string", "null"]},
    "grant_id": {"type": ["string", "null"]},
    "grant_expires_at": {"type": ["integer", "null"]},
    "http_status": {"type": ["integer", "null"]},
    "client_process_id": {"type": ["integer", "null"]},
    "client_executable": {"type": ["string", "null"]},
    "client_signer_subject": {"type": ["string", "null"]},
    "mtls_subject": {"type": ["string", "null"]},
    "request_payload_hash": {"type": ["string", "null"]},
    "result_payload_hash": {"type": ["string", "null"]},
    "details": {"type": "object"},
    "chain_partition": {"type": ["string", "null"]},
    "chain_sequence": {"type": ["integer", "null"]},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": ["string", "null"]}
  }
}

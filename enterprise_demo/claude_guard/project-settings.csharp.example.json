{
  "env": {
    "BAP_CONNECTOR_URL": "http://127.0.0.1:11022"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\Downloads\\Laptop_BAP_CCD\\laptop_bap_demo\\enterprise_demo\\claude_guard\\publish\\claude_guard.exe",
            "args": ["session-start"],
            "timeout": 10,
            "statusMessage": "ClaudeGuard: session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\Downloads\\Laptop_BAP_CCD\\laptop_bap_demo\\enterprise_demo\\claude_guard\\publish\\claude_guard.exe",
            "args": ["capture-intent"],
            "timeout": 10,
            "statusMessage": "ClaudeGuard: capture-intent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\Downloads\\Laptop_BAP_CCD\\laptop_bap_demo\\enterprise_demo\\claude_guard\\publish\\claude_guard.exe",
            "args": ["authorize"],
            "timeout": 10,
            "statusMessage": "ClaudeGuard: authorize"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\Downloads\\Laptop_BAP_CCD\\laptop_bap_demo\\enterprise_demo\\claude_guard\\publish\\claude_guard.exe",
            "args": ["permission-request"],
            "timeout": 10,
            "statusMessage": "ClaudeGuard: permission-request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\Downloads\\Laptop_BAP_CCD\\laptop_bap_demo\\enterprise_demo\\claude_guard\\publish\\claude_guard.exe",
            "args": ["post-tool"],
            "timeout": 10,
            "statusMessage": "ClaudeGuard: post-tool"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\User\\Downloads\\Laptop_BAP_CCD\\laptop_bap_demo\\enterprise_demo\\claude_guard\\publish\\claude_guard.exe",
            "args": ["session-end"],
            "timeout": 10,
            "statusMessage": "ClaudeGuard: session-end"
          }
        ]
      }
    ]
  }
}

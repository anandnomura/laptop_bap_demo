<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName Condition="'$(Configuration)' != 'Lab'">claude_guard</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' == 'Lab'">claude_guard_lab</AssemblyName>
    <RootNamespace>Company.Bap.ClaudeGuard</RootNamespace>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Lab'">
    <DefineConstants>$(DefineConstants);LAB_BUILD</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>
</Project>
